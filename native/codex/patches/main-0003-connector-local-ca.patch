+
+/// A root selected for one MCP origin never becomes a process-wide trust root.
+struct OriginCertificateHttpClient {
+    origin: String,
+    trusted: RouteAwareHttpClient,
+    fallback: Arc<dyn HttpClient>,
+}
+impl OriginCertificateHttpClient {
+    fn client(&self, params: &mut codex_exec_server::HttpRequestParams) -> &dyn HttpClient {
+        if url::Url::parse(&params.url).ok().is_some_and(|u| u.origin().ascii_serialization() == self.origin) {
+            params.redirect_policy = codex_exec_server::HttpRedirectPolicy::Stop;
+            &self.trusted
+        } else { self.fallback.as_ref() }
+    }
+}
+impl HttpClient for OriginCertificateHttpClient {
+    fn http_request(&self, mut params: codex_exec_server::HttpRequestParams) -> futures::future::BoxFuture<'_, Result<codex_exec_server::HttpRequestResponse, codex_exec_server::ExecServerError>> {
+        self.client(&mut params).http_request(params)
+    }
+    fn http_request_stream(&self, mut params: codex_exec_server::HttpRequestParams) -> futures::future::BoxFuture<'_, Result<(codex_exec_server::HttpRequestResponse, codex_exec_server::HttpResponseBodyStream), codex_exec_server::ExecServerError>> {
+        self.client(&mut params).http_request_stream(params)
