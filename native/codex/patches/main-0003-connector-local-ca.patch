+    pub fn with_root_certificate(factory: HttpClientFactory, pem: &[u8]) -> Result<Self, String> {
+        let tls = codex_http_client::HttpClientTlsConfig::default()
+            .with_root_certificate_pem(pem).map_err(|_| "invalid MCP CA certificate".to_string())?;
