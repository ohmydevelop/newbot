# Copy to .env; npm start loads this file. Development may use shell environment variables.
HOST=127.0.0.1
PORT=3100
PUBLIC_ORIGIN=http://localhost:3100
# Optional: set a password of at least 12 characters. Otherwise read .data/initial-password.
# ADMIN_PASSWORD=
DATA_DIR=.data
AGENT_WORKSPACE=.data/workspace
# Defaults to DATA_DIR/codex. The parent's CODEX_HOME is never inherited.
# Optional: choose another dedicated instance directory (never ~/.codex or ~/.agents).
# NEWBOT_CODEX_HOME=/absolute/path/to/newbot-codex-home
# Provider parameters persist in SQLite and restore automatically after restart.
# Optional trusted HTTPS bootstrap source (only without saved state); explicit reload also persists.
# NEWBOT_RUNTIME_CONFIG_URL=https://config.example.com/newbot/runtime
# Optional source Bearer token; never inherited by Codex or sent to the browser.
# NEWBOT_RUNTIME_CONFIG_TOKEN=
# Native diagnostics may include parameters; injected Providers use private tmpfs logs (Linux /dev/shm).
# NEWBOT_RUNTIME_LOG_ROOT=/dev/shm
# CODEX_BIN=/absolute/path/to/newbot/node_modules/.bin/codex
# TRUST_PROXY=true

# HTML execution previews and MCP Apps require a separate origin pointing to this server.
# This origin cannot also appear in PUBLIC_ORIGIN (including local aliases).
# For HTTPS hosting, use a separate App domain.
# APP_ORIGIN=https://apps.agent.example.com
# Optional OTLP exporter. Disabled when unset.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Temporary Cloudflare Quick Tunnels cannot carry SSE; select poll for sharing.
# AGENT_TRANSPORT=poll
# Enable the bundled, read-only synthetic MCP test server for this app-server only.
# ENABLE_TEST_MCP=true

MAX_ACTIVE_TURNS=2
# Native Codex OAuth listener and main-origin callback proxy (HTTPS hosting only).
# MCP_OAUTH_CALLBACK_PORT=1456
# MCP_OAUTH_CALLBACK_URL=https://agent.example.com/oauth/mcp/callback

# Additional server credential environment variable names editable by Provider settings.
# OPENAI_API_KEY and existing Provider references are recognized automatically; values stay server-side.
# PROVIDER_CREDENTIAL_ENV_ALLOWLIST=AZURE_OPENAI_API_KEY,LOCAL_MODEL_KEY
# Additional environment variable names that MCP settings may reference; never put values in Web forms.
# Existing MCP references are recognized automatically. ADMIN_PASSWORD/HOME/CODEX_HOME/NODE_OPTIONS are blocked.
# MCP_CREDENTIAL_ENV_ALLOWLIST=GITHUB_TOKEN,INTERNAL_MCP_TOKEN

# Optional Linux-only, fixed sudo identity check in Settings > Security.
# Requires a trusted setuid /usr/bin/sudo and a non-root Bridge user.
# No arbitrary commands, stored passwords, or Agent access. Disabled by default.
# SUDO_IDENTITY_CHECK=true

# Experimental native plugin APIs; explicitly opt in for a shared test instance in production mode.
# EXPERIMENTAL_PLUGINS=true
