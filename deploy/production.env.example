PUBLIC_ORIGIN=https://agent.example.com
APP_ORIGIN=https://apps.agent.example.com
NEWBOT_DATA_DIR=/srv/newbot/data
NEWBOT_IMAGE=newbot:stable
# This file is read by Compose AND as the container env_file. Keep it mode 0600.
# Optional ADMIN_PASSWORD (12+ characters); omit to generate /data/initial-password.
MCP_OAUTH_CALLBACK_PORT=1456
MCP_OAUTH_CALLBACK_URL=https://agent.example.com/oauth/mcp/callback
# Add only the provider environment variables required by your dedicated Codex config.
# OPENAI_API_KEY=
# SECONDARY_API_KEY=
