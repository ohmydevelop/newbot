{
  "name": "newbot-v1-integration-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "COPILOTKIT_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 node --test compatibility.test.mjs",
    "test:runtime": "COPILOTKIT_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 node --import tsx --test runtime.test.ts",
    "check": "tsc --noEmit",
    "build": "vite build",
    "test:render": "COPILOTKIT_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 node --import tsx --test markdown.test.ts",
    "verify:model": "COPILOTKIT_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 node --import tsx verify-real-model.ts",
    "serve:browser": "COPILOTKIT_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 node --import tsx serve-browser.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@a2ui/web_core": "0.15.0",
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@copilotkit/a2ui-renderer": "1.88.0",
    "@copilotkit/react-core": "1.88.0",
    "@copilotkit/react-ui": "1.88.0",
    "@copilotkit/runtime": "1.88.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@openai/apps-sdk-ui": "0.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.1",
    "streamdown": "1.6.11",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "katex": "0.16.47",
    "react-markdown": "9.0.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
