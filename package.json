{
  "name": "newbot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/concurrently/dist/bin/concurrently.js -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run build:mcp-test && tsc --noEmit && node scripts/build-web.mjs && esbuild server/index.ts server/runner/main.ts --bundle --platform=node --packages=external --format=esm --outdir=dist/server --splitting",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "generate:codex": "node scripts/generate-codex.mjs",
    "format": "prettier --write server web shared tests scripts docs README.md *.json *.ts compose.yaml",
    "build:mcp-test": "node scripts/build-test-mcp.mjs",
    "pretest": "npm run build:mcp-test",
    "mcp:test": "node dist/mcp-test/server.js",
    "test:container": "node scripts/container-smoke.mjs",
    "test:provider": "node scripts/verify-provider.mjs",
    "test:soak": "node scripts/soak.mjs",
    "backup": "node scripts/backup.mjs",
    "test:official": "node scripts/prepare-official-app.mjs && tsx --test tests/official-mcp-app.test.ts",
    "test:performance": "node scripts/benchmark-bridge.mjs",
    "test:artifact-ui": "node scripts/test-artifact-ui.mjs",
    "test:artifact-live": "node scripts/test-artifact-live.mjs",
    "test:html-preview": "node scripts/test-html-preview.mjs",
    "test:mcp-ui": "node scripts/test-mcp-ui.mjs",
    "test:html-live": "ARTIFACT_LIVE_HTML=1 node scripts/test-artifact-live.mjs",
    "test:artifact-lifecycle": "node scripts/test-artifact-lifecycle.mjs",
    "test:pdf-preview": "node scripts/test-pdf-preview.mjs",
    "test:skills-ui": "node scripts/test-skills-ui.mjs",
    "test:skills-live": "node --import tsx scripts/test-skills-live.mjs",
    "test:skills-use": "node scripts/test-skills-use.mjs",
    "test:skills-run-live": "node --env-file-if-exists=.env --import tsx scripts/test-skills-run-live.mjs",
    "test:configuration-ui": "node scripts/test-configuration-ui.mjs",
    "test:configuration-live": "node --import tsx scripts/test-configuration-live.mjs",
    "test:providers-ui": "node scripts/test-providers-ui.mjs",
    "test:providers-live": "node --import tsx scripts/test-providers-live.mjs",
    "test:mcp-config-ui": "node scripts/test-mcp-config-ui.mjs",
    "test:mcp-config-live": "node --import tsx scripts/test-mcp-config-live.mjs",
    "test:configuration-recovery-ui": "node scripts/test-configuration-recovery-ui.mjs",
    "test:configuration-recovery-live": "node --import tsx scripts/test-configuration-recovery-live.mjs",
    "test:app-lifecycle-ui": "node scripts/test-app-lifecycle-ui.mjs",
    "test:app-host-ui": "node scripts/test-app-host-ui.mjs",
    "test:elicitation-ui": "node scripts/test-elicitation-ui.mjs",
    "test:elicitation-live": "node --import tsx scripts/test-elicitation-live.mjs",
    "test:official-ui": "node scripts/test-official-app-ui.mjs",
    "dev:a2ui": "node scripts/a2ui-lab.mjs",
    "test:a2ui-ui": "node scripts/test-a2ui-ui.mjs",
    "test:a2ui-scenarios": "node --import tsx scripts/test-a2ui-scenarios.mjs",
    "dev:a2ui-catalog": "A2UI_CATALOG=1 node scripts/a2ui-lab.mjs",
    "test:a2ui-catalog-ui": "node scripts/test-a2ui-catalog-ui.mjs",
    "test:a2ui-chat-ui": "node scripts/test-a2ui-chat-ui.mjs",
    "test:a2ui-live": "node --env-file-if-exists=.env --import tsx scripts/test-a2ui-live.mjs",
    "test:credentials-ui": "node scripts/test-credentials-ui.mjs",
    "test:credential-storage-ui": "node scripts/test-credential-storage-ui.mjs",
    "test:credential-storage-native": "node --import tsx scripts/test-credential-storage-native.mjs",
    "test:sudo-ui": "node scripts/test-sudo-ui.mjs",
    "test:sudo-native": "node scripts/test-sudo-native.mjs",
    "test:credential-observability": "node scripts/test-credential-observability.mjs",
    "test:credential-isolation-ui": "node scripts/test-credential-isolation-ui.mjs",
    "test:credential-isolation-native": "CREDENTIAL_ISOLATION=true node --import tsx scripts/test-credential-storage-native.mjs",
    "test:chat-presentation-ui": "node scripts/test-chat-presentation-ui.mjs",
    "test:conversation-recovery-ui": "node scripts/test-conversation-recovery-ui.mjs",
    "test:interaction-ui": "node scripts/test-interaction-ui.mjs",
    "test:browser-runtime": "node scripts/test-browser-runtime.mjs",
    "test:issue-ui": "node scripts/test-issue-20261109-ui.mjs",
    "test:session-native": "node --import tsx scripts/test-session-native.mjs",
    "test:native-compat": "node scripts/verify-native-compat.mjs",
    "test:controls-ui": "node scripts/test-controls-ui.mjs",
    "test:runtime-isolation": "node --import tsx scripts/verify-runtime-isolation.mjs",
    "test:provider-memory-native": "node --import tsx scripts/test-provider-memory-native.mjs",
    "test:provider-sqlite-native": "node --import tsx scripts/test-provider-memory-native.mjs",
    "test:provider-sqlite-ui": "ISSUE_MEMORY_PROVIDERS=1 UI_EVIDENCE_DIR=.issue/2026-11-10/evidence-sqlite/ui node scripts/test-ui-regression.mjs",
    "test:credential-sqlite-native": "CREDENTIAL_SQLITE_CONFIG=true node --import tsx scripts/test-credential-storage-native.mjs",
    "test:credential-memory-native": "CREDENTIAL_MEMORY_CONFIG=true node --import tsx scripts/test-credential-storage-native.mjs",
    "test:provider-memory-ui": "ISSUE_MEMORY_PROVIDERS=1 UI_EVIDENCE_DIR=.issue/2026-11-10/evidence/ui node scripts/test-ui-regression.mjs",
    "test:ui-regression": "node scripts/test-ui-regression.mjs",
    "runner": "node dist/server/runner/main.js",
    "runner:dev": "tsx server/runner/main.ts",
    "lint:ui": "eslint web && stylelint web/settings.css && node scripts/check-design-ownership.mjs",
    "test:ui-contracts": "playwright test --config=playwright.config.ts",
    "verify:release": "node --import tsx scripts/verify-release.ts",
    "test:mobile-contracts": "playwright test --config=playwright.mobile.config.ts",
    "test:oauth-local": "node --import tsx scripts/test-local-oauth.ts",
    "test:modes-native": "node --import tsx scripts/test-session-modes-native.ts",
    "test:modes-baseline": "python3 scripts/test-mode-native-baseline.py"
  },
  "dependencies": {
    "@a2ui/web_core": "0.14.0",
    "@ag-ui/core": "1.0.4",
    "@ag-ui/encoder": "1.0.4",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "10.1.10",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@openai/codex": "0.165.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/sdk-node": "0.301.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slider": "1.6.1",
    "echarts": "^6.0.0",
    "fastify": "^5.6.2",
    "katex": "0.19.1",
    "lucide-react": "^0.552.0",
    "mermaid": "12.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "shiki": "^3.15.0",
    "undici": "8.12.4",
    "unified": "11.0.5",
    "yauzl": "3.4.0",
    "zod": "^4.1.12",
    "zod-to-json-schema": "3.25.2",
    "zod3": "npm:zod@3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@a2ui/react": "0.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "eslint": "10.15.0",
    "pdfjs-dist": "6.5.438",
    "prettier": "3.6.2",
    "stylelint": "18.0.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "^7.2.2"
  },
  "overrides": {
    "katex": "0.19.1",
    "dompurify": "3.4.17"
  }
}
